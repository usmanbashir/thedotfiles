#!/usr/bin/env python3
"""piper-stream — sentence-by-sentence Piper streaming with a read-along view.

Loads a Piper voice once and synthesizes sentence by sentence, writing raw
signed 16-bit little-endian PCM to stdout for a continuously-open player
(`paplay --raw`). `tts` uses this for its --show-text path: a plain
`piper --output-raw` already streams audio fine, but it can't reveal sentence
boundaries, so the read-along needs per-sentence control with the model kept
loaded (a shell loop would reload the model — ~3.5s — every sentence).

Reads UTF-8 text from stdin. Must run under a Python that has the `piper`
package (the piper-tts tool venv); `tts` invokes it with that interpreter.
The sample rate comes from the voice; print it for the caller with --print-rate
or just read it from the voice JSON (tts does the latter).
"""
import argparse
import re
import sys


def split_sentences(text):
    """Split text into sentence-ish units at .!? boundaries, whitespace-normalized."""
    text = " ".join(text.split())
    parts = re.split(r"(?<=[.!?])\s+", text)
    return [p for p in (s.strip() for s in parts) if p]


def open_display(enabled):
    """Return a function that prints each spoken sentence for a read-along view.

    Writes to the controlling terminal (/dev/tty) so it never mixes into stdout
    (raw PCM) or stderr (errors). Falls back to stderr if there's no tty, and to
    a no-op when disabled. Printed just before a sentence is synthesized, so with
    pipe backpressure the text stays ~1-3s ahead of the audio.
    """
    if not enabled:
        return lambda _sentence: None
    try:
        tty = open("/dev/tty", "w")
    except OSError:
        tty = sys.stderr

    def show(sentence):
        tty.write(sentence + "\n")
        tty.flush()

    return show


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--model", required=True, help="path to the voice .onnx file")
    parser.add_argument("--config", help="path to the voice .onnx.json (defaults to model+.json)")
    parser.add_argument(
        "--length-scale",
        type=float,
        default=1.0,
        help="phoneme length scale; < 1 is faster (inverse of speed)",
    )
    parser.add_argument(
        "--show-text",
        action="store_true",
        help="print each sentence to the terminal as it is spoken",
    )
    args = parser.parse_args()

    try:
        from piper import PiperVoice, SynthesisConfig
    except ImportError as exc:
        sys.stderr.write(
            "piper-stream: missing the piper package — run me under the "
            "piper-tts venv (tts does this automatically): %s\n" % exc
        )
        return 1

    text = sys.stdin.buffer.read().decode("utf-8", "replace")
    sentences = split_sentences(text)
    if not sentences:
        return 0

    voice = PiperVoice.load(args.model, config_path=args.config)
    syn = SynthesisConfig(length_scale=args.length_scale)
    show = open_display(args.show_text)
    out = sys.stdout.buffer
    try:
        for sentence in sentences:
            show(sentence)
            for chunk in voice.synthesize(sentence, syn_config=syn):
                out.write(chunk.audio_int16_bytes)
                out.flush()
    except BrokenPipeError:
        # Player exited (e.g. Ctrl-C) — stop quietly.
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
