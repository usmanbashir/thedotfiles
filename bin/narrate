#!/usr/bin/env bash
# narrate — read text aloud with Kokoro (higher-quality, natural TTS)
#
# Reads text from arguments or stdin and streams it to the speakers, or saves
# audio with -o (WAV or MP3, chosen by extension). Kokoro sounds more natural
# than Piper but is slower, so it's for long-form listening. For quick everyday
# speech use `tts` (Piper).
#
# Setup is handled by setup.sh (uv tool install kokoro-tts + model download).
# The Kokoro model and voices live in $KOKORO_DIR, and the tool is run from
# there because it loads kokoro-v1.0.onnx / voices-v1.0.bin from the working
# directory.
set -euo pipefail

VOICE="${NARRATE_VOICE:-af_heart}"
LANG_CODE="${NARRATE_LANG:-en-us}"
SPEED="${NARRATE_SPEED:-1.0}"
KOKORO_DIR="${KOKORO_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/kokoro}"
OUT=""
RAW=0

usage() {
    cat <<EOF
Usage: narrate [-v VOICE] [-l LANG] [-s SPEED] [-o FILE] [TEXT...]

Read TEXT aloud with Kokoro, or save it to FILE (.wav/.mp3) with -o.
With no TEXT, reads from stdin.

Options:
  -v VOICE   Kokoro voice (default: $VOICE; or set \$NARRATE_VOICE)
  -l LANG    Language code (default: $LANG_CODE; or set \$NARRATE_LANG)
  -s SPEED   Speech speed (default: $SPEED; or set \$NARRATE_SPEED)
  -o FILE    Save to FILE (.wav or .mp3) instead of playing
  -R, --raw  Read TEXT verbatim (skip the default Markdown stripping)
  -h         Show this help

By default TEXT is run through \`unmd\` to strip Markdown (headings, **bold**,
links, fenced code, etc.) so the syntax isn't read aloud. Use --raw to disable.

Examples:
  narrate "Once upon a time..."
  wl-paste | narrate                 # read the clipboard aloud
  narrate < README.md                # Markdown read aloud, syntax stripped
  narrate --raw "Keep the * asterisks *."
  narrate -v am_michael "Hello."
  narrate -o chapter1.mp3 < chapter1.txt
EOF
}

# Accept --raw as a long alias for -R (getopts only handles short options).
for arg do
    shift
    case "$arg" in
        --raw) set -- "$@" -R ;;
        *)     set -- "$@" "$arg" ;;
    esac
done

while getopts ":v:l:s:o:Rh" opt; do
    case "$opt" in
        v) VOICE="$OPTARG" ;;
        l) LANG_CODE="$OPTARG" ;;
        s) SPEED="$OPTARG" ;;
        o) OUT="$OPTARG" ;;
        R) RAW=1 ;;
        h) usage; exit 0 ;;
        \?) echo "narrate: unknown option -$OPTARG" >&2; usage >&2; exit 2 ;;
        :) echo "narrate: option -$OPTARG requires an argument" >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))

command -v kokoro-tts >/dev/null 2>&1 || {
    echo "narrate: kokoro-tts not found. Run the dotfiles setup.sh (Linux) to install it." >&2
    exit 1
}
if [ ! -f "$KOKORO_DIR/kokoro-v1.0.onnx" ] || [ ! -f "$KOKORO_DIR/voices-v1.0.bin" ]; then
    echo "narrate: Kokoro model files missing in $KOKORO_DIR. Run setup.sh to download them." >&2
    exit 1
fi

# Text from args, else stdin.
if [ "$#" -gt 0 ]; then
    text="$*"
else
    text="$(cat)"
fi

# Strip Markdown to plain text unless --raw was given, so syntax like **bold**,
# # headings and links aren't read aloud. unmd is a sibling script; fall back to
# PATH, and if it's missing read the text as-is rather than failing.
if [ "$RAW" -eq 0 ]; then
    unmd="$(dirname "$0")/unmd"
    [ -x "$unmd" ] || unmd=unmd
    if command -v "$unmd" >/dev/null 2>&1; then
        text="$(printf '%s' "$text" | "$unmd")"
    else
        echo "narrate: unmd not found; reading text as-is (use --raw to silence)" >&2
    fi
fi

[ -n "${text//[[:space:]]/}" ] || { echo "narrate: no text given" >&2; exit 2; }

opts=(--voice "$VOICE" --lang "$LANG_CODE" --speed "$SPEED")

# kokoro-tts has no quiet flag: it spams status text to stdout and a progress
# spinner to stderr. Audio always goes to the file or the sound device (never
# stdout), so capture both streams and only replay them if the run fails —
# keeps success silent without swallowing real errors.
log="$(mktemp)"
trap 'rm -f "$log"' EXIT

# ---- File output: use the kokoro-tts CLI (handles wav/mp3 encoding) ----------
# kokoro-tts loads its model/voices from the current directory, so run it from
# $KOKORO_DIR; output paths must therefore be absolute.
if [ -n "$OUT" ]; then
    case "$OUT" in
        /*) out_abs="$OUT" ;;
        *)  out_abs="$PWD/$OUT" ;;
    esac
    case "$OUT" in
        *.mp3) fmt=mp3 ;;
        *)     fmt=wav ;;
    esac
    if ! printf '%s' "$text" \
        | ( cd "$KOKORO_DIR" && kokoro-tts - "$out_abs" --format "$fmt" "${opts[@]}" ) \
            >"$log" 2>&1; then
        cat "$log" >&2
        exit 1
    fi
    exit 0
fi

# ---- Streaming playback ------------------------------------------------------
# Prefer the bundled gapless streamer (kokoro-stream): it generates sentence by
# sentence with kokoro_onnx and pipes one continuous raw-PCM stream into a
# single open player, eliminating the per-chunk gaps of `kokoro-tts --stream`.
# It reuses the kokoro-tts tool venv's Python (which provides kokoro_onnx), so
# no extra dependencies. Falls back to the CLI if the streamer, that Python, or
# a raw-capable player (paplay/aplay) isn't available.
rate=24000  # kokoro_onnx SAMPLE_RATE
helper="$(dirname "$0")/kokoro-stream"
venv_python="$(dirname "$(readlink -f "$(command -v kokoro-tts)")")/python"

player=()
if command -v paplay >/dev/null 2>&1; then
    player=(paplay --raw --format=s16le --rate="$rate" --channels=1)
elif command -v aplay >/dev/null 2>&1; then
    player=(aplay -q -r "$rate" -f S16_LE -c 1 -t raw -)
fi

if [ -x "$helper" ] && [ -x "$venv_python" ] && [ "${#player[@]}" -gt 0 ]; then
    if ! printf '%s' "$text" \
        | "$venv_python" "$helper" \
            --model "$KOKORO_DIR/kokoro-v1.0.onnx" \
            --voices "$KOKORO_DIR/voices-v1.0.bin" \
            "${opts[@]}" 2>"$log" \
        | "${player[@]}" 2>>"$log"; then
        cat "$log" >&2
        exit 1
    fi
    exit 0
fi

# Fallback: kokoro-tts CLI --stream (chunked, small gaps between chunks).
if ! printf '%s' "$text" | ( cd "$KOKORO_DIR" && kokoro-tts - --stream "${opts[@]}" ) >"$log" 2>&1; then
    cat "$log" >&2
    exit 1
fi
