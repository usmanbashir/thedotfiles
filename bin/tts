#!/usr/bin/env bash
# tts — speak text aloud with Piper (fast, local neural TTS)
#
# Reads text from arguments or stdin and plays it through the speakers, or
# writes a WAV with -o. Piper is quick on CPU, so this is the everyday
# "say this" command. For more natural long-form narration use `narrate`
# (Kokoro) instead.
#
# Install/setup is handled by the repo's setup.sh (uv tool install piper-tts +
# voice download). Voice models live in $TTS_DATA_DIR.
set -euo pipefail

VOICE="${TTS_VOICE:-en_US-lessac-high}"
DATA_DIR="${TTS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/piper/voices}"
SPEED="${TTS_SPEED:-1.0}"
OUT=""

usage() {
    cat <<EOF
Usage: tts [-v VOICE] [-s SPEED] [-o FILE] [TEXT...]

Speak TEXT aloud with Piper, or save it to FILE with -o.
With no TEXT, reads from stdin.

Options:
  -v VOICE   Piper voice name (default: $VOICE; or set \$TTS_VOICE)
  -s SPEED   Playback speed multiplier, e.g. 1.5, 2, 3 (default: $SPEED; or set \$TTS_SPEED)
  -o FILE    Write a WAV to FILE instead of playing
  -h         Show this help

Examples:
  tts "Build finished."
  echo "Hello there" | tts
  tts -s 2 "Read this twice as fast."
  tts -v en_GB-alan-medium "Good evening."
  tts -o note.wav "Saved to a file."
EOF
}

while getopts ":v:s:o:h" opt; do
    case "$opt" in
        v) VOICE="$OPTARG" ;;
        s) SPEED="$OPTARG" ;;
        o) OUT="$OPTARG" ;;
        h) usage; exit 0 ;;
        \?) echo "tts: unknown option -$OPTARG" >&2; usage >&2; exit 2 ;;
        :) echo "tts: option -$OPTARG requires an argument" >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))

# Piper speed is the inverse "phoneme length scale" (< 1 is faster), so convert
# the friendly speed multiplier to a length scale of 1/SPEED.
length_scale="$(awk -v s="$SPEED" 'BEGIN { if (s+0 <= 0) exit 1; printf "%.6f", 1/s }')" || {
    echo "tts: -s SPEED must be a positive number (got '$SPEED')" >&2
    exit 2
}

command -v piper >/dev/null 2>&1 || {
    echo "tts: piper not found. Run the dotfiles setup.sh (Linux) to install it." >&2
    exit 1
}

# Text from args, else stdin.
if [ "$#" -gt 0 ]; then
    text="$*"
else
    text="$(cat)"
fi
[ -n "${text//[[:space:]]/}" ] || { echo "tts: no text given" >&2; exit 2; }

if [ -n "$OUT" ]; then
    piper -m "$VOICE" --data-dir "$DATA_DIR" --length-scale "$length_scale" -f "$OUT" -- "$text"
    exit 0
fi

# Play. Prefer true streaming: pipe Piper's raw PCM straight into a player so
# audio starts as the first sentence is synthesized, instead of waiting for the
# whole text to render. paplay/aplay read raw PCM from stdin; pw-play/ffplay
# don't, so they fall back to a buffered temp WAV below.

# Raw PCM has no header, so the player needs the voice's sample rate, which
# lives in the voice's JSON config (defaults to 22050 if it can't be read).
rate=22050
cfg="$DATA_DIR/$VOICE.onnx.json"
if [ -f "$cfg" ]; then
    if command -v jq >/dev/null 2>&1; then
        rate="$(jq -r '.audio.sample_rate // 22050' "$cfg" 2>/dev/null || echo 22050)"
    else
        rate="$(grep -o '"sample_rate"[[:space:]]*:[[:space:]]*[0-9]*' "$cfg" | grep -o '[0-9]*$' || echo 22050)"
    fi
fi

if command -v paplay >/dev/null 2>&1; then
    piper -m "$VOICE" --data-dir "$DATA_DIR" --length-scale "$length_scale" --output-raw -- "$text" \
        | paplay --raw --format=s16le --rate="$rate" --channels=1
    exit 0
elif command -v aplay >/dev/null 2>&1; then
    piper -m "$VOICE" --data-dir "$DATA_DIR" --length-scale "$length_scale" --output-raw -- "$text" \
        | aplay -q -r "$rate" -f S16_LE -c 1 -t raw -
    exit 0
fi

# Fallback for players that can't read raw stdin (pw-play, ffplay): buffer to a
# temp WAV whose header carries the rate, then play that.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
piper -m "$VOICE" --data-dir "$DATA_DIR" --length-scale "$length_scale" -f "$tmp" -- "$text"
for player in pw-play ffplay; do
    command -v "$player" >/dev/null 2>&1 || continue
    case "$player" in
        ffplay) ffplay -autoexit -nodisp -loglevel quiet "$tmp" ;;
        *)      "$player" "$tmp" ;;
    esac
    exit 0
done

echo "tts: no audio player found (tried paplay aplay pw-play ffplay)." >&2
exit 1
